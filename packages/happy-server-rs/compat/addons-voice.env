# Addons voice, LiveKit only. Test values, not credentials: nothing listens on
# LIVEKIT_URL, so a stream start fails after its conversation is recorded.
LIVEKIT_API_KEY=compat-livekit-key
LIVEKIT_API_SECRET=compat-livekit-secret-not-a-real-one
LIVEKIT_URL=ws://127.0.0.1:3297
LIVEKIT_PUBLIC_URL=wss://livekit.example.test
