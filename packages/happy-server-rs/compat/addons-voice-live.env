# Addons voice against a real LiveKit server with the happy-voice agent.
# VOICE_LIVE_ENV names a file holding LIVEKIT_API_KEY and LIVEKIT_API_SECRET
# (kept out of the repository); LIVEKIT_URL defaults to a local server, and
# LIVEKIT_PUBLIC_URL (required by the Rust server, no default) to a test value.
. "${VOICE_LIVE_ENV:?set VOICE_LIVE_ENV to a file with the LiveKit keys}"
LIVEKIT_URL="${VOICE_LIVE_URL:-ws://127.0.0.1:7880}"
LIVEKIT_PUBLIC_URL="${LIVEKIT_PUBLIC_URL:-wss://livekit.example.test}"
VOICE_BACKENDS=stream
ELEVENLABS_API_KEY=
