<?xml version="1.0" encoding="utf-8"?>
<!-- PopupMotion's dialog: up from 0.92 about the centre, fading in over the first half, 200 ms emphasized-decelerate. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@anim/happy_emphasized_decelerate"
    android:shareInterpolator="true">
    <scale
        android:duration="200"
        android:fromXScale="0.92"
        android:fromYScale="0.92"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
    <alpha
        android:duration="100"
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
