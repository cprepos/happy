# Live browser stack settings. Copy to browser-stack/browser/.env.browser (gitignored)
# only to change a default; every line is optional.
#
# Secrets are NOT set here. `make browser-init` generates them into
# ~/.local/share/happy-browser/secrets/ (mode 600) and the Makefile passes
# secrets/browser.env to compose. Its keys, for reference:
#   API_BEARER_TOKEN=            auto-browser controller token (also secrets/api-token)
#   VNC_PASSWORD=                noVNC password, 8 characters (also secrets/vnc-password)
#   AUTH_STATE_ENCRYPTION_KEY=   Fernet key for saved logins (secrets/auth-state-key)
#   SHARE_TOKEN_SECRET=          signs observer tokens (secrets/share-token-secret)

# Xvfb screen and Chromium window, in pixels. A desktop screen by default,
# 16:10 like the iOS mini player; the live frame and the bridge follow these too.
# The page is the screen less Chromium's tab strip and address bar (87 px), or
# the whole screen with BROWSER_KIOSK=1; browser.mk works it out.
# BROWSER_WIDTH=1920
# BROWSER_HEIGHT=1200

# 0 (default): a normal Chromium window, maximized, with its tab strip and
# address bar, so whoever is in control can type URLs (policy.json still
# blocks chrome://, file:// and the rest). 1: the old kiosk, fullscreen with
# no browser UI.
# BROWSER_KIOSK=0

# The browser in the browser node and every pod. 0 (default): the upstream
# image's bundled Chrome for Testing. 1: Google Chrome stable, from the image
# node-chrome/Dockerfile builds locally (make browser-up builds it first), so
# the window reads "<page title> - Google Chrome"; that image also carries the
# Noto CJK and color emoji fonts. Google Chrome may not be
# redistributed: never push that image. BROWSER_NODE_IMAGE names any other
# pinned node image (name@sha256:<digest> or a local sha256:<image id>).
# BROWSER_NODE_CHROME=0
# BROWSER_NODE_IMAGE=

# Loopback ports (always bound to 127.0.0.1).
# NOVNC_PORT=6080
# API_PORT=8010
# BRIDGE_PORT=6090

# The bridge's optional LAN listener (README, "LAN listener"): 6090 on one LAN
# address, for the listed clients only. Both or neither. Unset: loopback only.
# BRIDGE_LAN_BIND=192.168.2.72
# BRIDGE_LAN_ALLOW=192.168.2.55,192.168.2.56

# MAX_SESSIONS=3
# MCP_TOOL_PROFILE=curated
# REQUEST_RATE_LIMIT_REQUESTS=1200
# Redact PII found by OCR in screenshots and live frames (costs OCR per frame).
# PII_SCRUB_SCREENSHOT=true
# LOG_LEVEL=INFO
