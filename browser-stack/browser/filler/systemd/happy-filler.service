# The secret filler, as a systemd user unit of the happy-filler account (uid
# 1990). scripts/filler-install.sh (make filler-install) copies it from the
# installed release to ~happy-filler/.config/systemd/user/ and enables it; linger (set once by
# filler-account-setup.sh) starts it at boot. It runs the reviewed release under
# /srv/happy-filler/current with the host's node, listens on 127.0.0.1:6091
# only, and reaches the vault on 127.0.0.1:8222 and the browser controllers on
# 127.0.0.1:8010 and 8100-8131.
#
# PrivateUsers=yes is what makes the mount-namespace options below take effect:
# a user manager (systemd 245 here) silently ignores PrivateTmp, ProtectSystem
# and ProtectHome without it. Inside, only uid/gid 1990 map; files owned by
# anyone else (root, prep) show as 65534, so the policy must be owned by
# happy-filler (lib/policy.mjs accepts its own uid). SystemCallFilter is a
# deny list: node 20 is killed by the @system-service allow list on systemd 245.
# MemoryDenyWriteExecute is left off (V8's JIT needs W+X pages).
[Unit]
Description=Happy secret filler (127.0.0.1:6091)
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/srv/happy-filler/current/app
ExecStart=/usr/bin/node --disallow-code-generation-from-strings /srv/happy-filler/current/app/server.mjs
Environment=FILLER_HOST=127.0.0.1
Environment=FILLER_PORT=6091
Environment=VAULT_URL=http://127.0.0.1:8222
Environment=FILLER_CONTROLLER_PORT=8010
Environment=FILLER_CONTROLLER_PORTS=8010,8100-8131
Environment=FILLER_HOME=/srv/happy-filler
Environment=NODE_OPTIONS=
UnsetEnvironment=FILLER_TEST_ALLOW_LOOPBACK_HTTP FILLER_POLICY
Restart=always
RestartSec=3
TimeoutStopSec=10
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateUsers=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/happy-filler/state /srv/happy-filler/audit
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
