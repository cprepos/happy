# /etc/sudoers.d/happy-svc, installed 0440 root:root by selfhost/svc/setup-root.sh after
# visudo -cf. @OPERATOR@ is replaced with the operator's account (prep).
#
# The operator may run the happy-svc-ctl wrapper as happy-svc without a password, with only
# these verbs as its first argument (the wrapper checks every later argument itself). The
# verbs that change what the filler trusts (admin-tty: enroll, policy-edit) or replace its
# data (import) are left out: they need the operator's own sudo password, which agents do
# not have. Nothing here allows running anything as root.
Cmnd_Alias HAPPY_SVC_CTL = \
    /usr/local/libexec/happy-svc-ctl up, /usr/local/libexec/happy-svc-ctl up *, \
    /usr/local/libexec/happy-svc-ctl down, /usr/local/libexec/happy-svc-ctl down *, \
    /usr/local/libexec/happy-svc-ctl restart *, \
    /usr/local/libexec/happy-svc-ctl status, \
    /usr/local/libexec/happy-svc-ctl logs *, \
    /usr/local/libexec/happy-svc-ctl ports, \
    /usr/local/libexec/happy-svc-ctl init, \
    /usr/local/libexec/happy-svc-ctl admin *, \
    /usr/local/libexec/happy-svc-ctl tokens-export, \
    /usr/local/libexec/happy-svc-ctl controller-token, \
    /usr/local/libexec/happy-svc-ctl backup
Defaults!/usr/local/libexec/happy-svc-ctl env_reset, !setenv, umask=0077, \
    secure_path="/usr/sbin:/usr/bin:/sbin:/bin", !env_keep
@OPERATOR@ ALL=(happy-svc) NOPASSWD: HAPPY_SVC_CTL
