# happy-svc's rootless Docker daemon: a systemd user unit of happy-svc, installed into
# ~happy-svc/.config/systemd/user/ by selfhost/svc/setup-root.sh. Based on the unit that
# dockerd-rootless-setuptool.sh writes, with the network choices fixed here:
#   slirp4netns, sandboxed and seccomp-filtered;
#   builtin port driver: fast, and it dials 127.0.0.1 inside the namespace, where the
#     host-network services bind (source addresses show as 127.0.0.1);
#   host loopback disabled: no container reaches the host's 127.0.0.1 (no 10.0.2.2 hole).
[Unit]
Description=Docker Application Container Engine (rootless, happy-svc)
Documentation=https://docs.docker.com/go/rootless/
Requires=dbus.socket

[Service]
Environment=PATH=/usr/bin:/sbin:/usr/sbin:/bin
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_NET=slirp4netns
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_PORT_DRIVER=builtin
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_DISABLE_HOST_LOOPBACK=true
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_SLIRP4NETNS_SANDBOX=true
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_SLIRP4NETNS_SECCOMP=true
ExecStart=/usr/bin/dockerd-rootless.sh
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutSec=0
RestartSec=2
Restart=always
StartLimitBurst=3
StartLimitInterval=60s
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=0
TasksMax=infinity
Delegate=yes
Type=notify
NotifyAccess=all
KillMode=mixed

[Install]
WantedBy=default.target
