#!/bin/sh
# happy-svc-ctl: the one way into the happy-svc rootless Docker daemon.
#
# Installed root:root 0755 at /usr/local/libexec/happy-svc-ctl by setup-root.sh, from the
# root-owned release in /opt/happy-svc/current (never from a working tree). prep reaches it
# only through /etc/sudoers.d/happy-svc:
#
#   sudo -n -u happy-svc /usr/local/libexec/happy-svc-ctl <verb> [args]
#
# Every verb maps to fixed docker / docker compose commands against the fixed compose files
# of the release. Arguments are matched whole against fixed words or short character
# classes (case patterns, so a newline can never smuggle a second line past a check); none
# is ever passed to a shell or used in a path. No eval. Every child process gets a cleared
# environment (env -i) with the values set below. Each run is logged to the journal with the
# verb and the caller, never an argument value.
#
# Verbs (the sudoers drop-in lets prep run the first group without a password; the second
# needs prep's own sudo password, which agents do not have):
#   up [vault|browser]            compose up (vault, then browser), then publish ports; with
#                                 BROWSER_NODE_CHROME=1 in browser.env, first build the release's
#                                 node-chrome/Dockerfile in this daemon (cached when unchanged)
#   down [vault|browser]          compose down (browser, then vault); volumes are kept
#   restart <vault|browser> [svc] compose restart
#   status                        containers, published ports, loopback-only check
#   logs <vault|browser> <svc> [follow]
#   ports                         publish ports.list on 127.0.0.1 (run by happy-svc-ports.service too)
#   init                          browser secrets (browser-init.sh) and the filler's empty layout
#   admin <sub> [NAME=..|ROTATE=1|CLIENT=..]   non-interactive filler admin commands
#   tokens-export                 client tokens on stdout, "<name> <token>" lines, for make svc-tokens
#   controller-token              the browser controller token into the filler's inbox, then take it
#   backup                        tar every data volume into ~happy-svc/backups/<ts>/ and the mirrors
#  password sudo only:
#   admin-tty <enroll|policy-edit>   interactive, on your terminal
#   import <volume>               <drop>/in/<volume>.tar into a new, empty volume

# SC2015: every "A && B || die" here is a guard where die is the intended result of any failure.
# SC2016: single-quoted jq programs and in-container sh scripts expand nothing here on purpose.
# shellcheck disable=SC2015,SC2016
set -eu
umask 077

PROD_SELF=/usr/local/libexec/happy-svc-ctl
SVC_USER=happy-svc

die() { printf 'happy-svc-ctl: %s\n' "$*" >&2; exit 2; }

# --- mode: production constants, or a test tree. Test mode exists only when this file runs
# from anywhere but its installed path, never under sudo, and only with HAPPY_SVC_CTL_TEST=1.
# The installed copy ignores every HAPPY_SVC_CTL_* variable.
if [ "$0" = "$PROD_SELF" ]; then
    MODE='prod'
    PATH=/usr/sbin:/usr/bin:/sbin:/bin
    REL=/opt/happy-svc/current
    ETC=/etc/happy-svc
    DROP=/var/lib/happy-svc-drop
    HOME_DIR=/var/lib/happy-svc
else
    [ "${HAPPY_SVC_CTL_TEST:-}" = 1 ] || die "run the installed copy: sudo -n -u $SVC_USER $PROD_SELF <verb>"
    [ -z "${SUDO_UID:-}${SUDO_USER:-}" ] || die "test mode is refused under sudo"
    T=${HAPPY_SVC_CTL_TEST_ROOT:?test mode needs HAPPY_SVC_CTL_TEST_ROOT}
    [ -d "$T/bin" ] || die "test mode: $T/bin is missing"
    MODE='test'
    PATH=$T/bin:/usr/bin:/bin
    REL=$T/opt/current
    ETC=$T/etc
    DROP=$T/drop
    HOME_DIR=$T/home
    SVC_USER=$(id -un)
fi
export PATH

# --- who and where
[ "$(id -un)" = "$SVC_USER" ] || die "runs as $SVC_USER only (sudo -n -u $SVC_USER $PROD_SELF ...)"
SVC_UID=$(id -u)
if [ "$MODE" = prod ]; then RUNDIR=/run/user/$SVC_UID; else RUNDIR=$T/run; fi
SOCK=$RUNDIR/docker.sock
RK_API=$RUNDIR/dockerd-rootless/api.sock
DATA=$HOME_DIR/data
BACKUPS=$HOME_DIR/backups
CALLER=${SUDO_USER:-$(id -un)}

if [ "$MODE" = prod ]; then
    # This file, the release it points at, and /etc/happy-svc: root's, and nobody else may write them.
    for p in "$PROD_SELF" /opt/happy-svc /opt/happy-svc/releases "$REL/" "$ETC"; do
        [ -e "$p" ] || continue
        o=$(stat -L -c '%u %a' "$p")
        case $o in
            "0 "*[2367][0-7]|"0 "*[0-7][2367]) die "$p is group- or world-writable; refusing" ;;
            "0 "*) ;;
            *) die "$p is not owned by root; refusing" ;;
        esac
    done
fi

# The fixed V2.1 interface (README, "What the compose files must provide").
VAULT_FILES="-f $REL/selfhost/vault/compose.vault.yml -f $REL/selfhost/svc/compose.rootless.vault.yml"
BROWSER_FILES="-f $REL/browser-stack/browser/compose.browser.yml -f $REL/selfhost/svc/compose.rootless.browser.yml"
BROWSER_HOME=$DATA/browser
# The filler's one volume (vault-init.sh): outbox/ holds new client tokens, inbox/ takes the
# controller token.
FILLER_VOLUME=happy-filler
# node:22-alpine, the image the browser compose already pins; used for one-shot tar and copy jobs.
HELPER_IMAGE=node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914

# The browser node with Google Chrome (BROWSER_NODE_CHROME=1 in $ETC/browser.env): built here,
# in this daemon, from the release's node-chrome/Dockerfile (its pinned base image and its
# SHA256-checked downloads), tagged as browser.mk tags it, and run by its local image id. Never
# an image from elsewhere, and never a name from the settings.
NODE_CHROME_DIR=$REL/browser-stack/browser/node-chrome

# Every child: a cleared environment, the daemon's socket, the fixed data paths, LAN listener off.
# The browser services keep their own non-root uids (compose defaults, mapped through the subuid
# range). HAPPY_DOCKER_SOCKET is the docker-proxy's upstream: this daemon's socket, whose group
# inside the namespace is 0 (DOCKER_SOCKET_GID).
denv() {
    env -i PATH="$PATH" HOME="$HOME_DIR" LANG=C.UTF-8 \
        XDG_RUNTIME_DIR="$RUNDIR" DOCKER_HOST="unix://$SOCK" DOCKER_CONFIG="$HOME_DIR/.docker" \
        HAPPY_DOCKER_SOCKET="$SOCK" \
        HAPPY_BROWSER_HOME="$BROWSER_HOME" HAPPY_BROWSER_DIR="$REL/browser-stack/browser" \
        BROWSER_PROJECT=happy-browser \
        DOCKER_SOCKET_GID=0 \
        BROWSER_NODE_IMAGE= \
        BRIDGE_LAN_BIND= BRIDGE_LAN_ALLOW= BRIDGE_LAN_PUBLIC_BASE= \
        "$@"
}

# BROWSER_NODE_CHROME from root's browser.env (deploy-root.sh checked it; checked again here).
node_chrome() {
    c=0
    if [ -f "$ETC/browser.env" ]; then c=$(sed -n 's/^BROWSER_NODE_CHROME=//p' "$ETC/browser.env" | tail -n 1); fi
    case $c in ''|0) echo 0 ;; 1) echo 1 ;; *) die "BROWSER_NODE_CHROME in $ETC/browser.env is not 0 or 1" ;; esac
}

# happy-browser-node-chrome:<Chrome version>-<IMAGE_REVISION>, from the release's Dockerfile.
node_chrome_tag() {
    df=$NODE_CHROME_DIR/Dockerfile
    [ -f "$df" ] || die "node-chrome: no Dockerfile in the release"
    v=$(sed -n 's/^ARG CHROME_VERSION=\([0-9.]*\)-[0-9]*$/\1/p' "$df" | head -n 1)
    r=$(sed -n 's/^ARG IMAGE_REVISION=\([0-9]*\)$/\1/p' "$df" | head -n 1)
    case $v in ''|.*|*.|*[!0-9.]*) die "node-chrome: bad CHROME_VERSION in the Dockerfile" ;; esac
    case $r in ''|*[!0-9]*) die "node-chrome: bad IMAGE_REVISION in the Dockerfile" ;; esac
    printf 'happy-browser-node-chrome:%s-%s' "$v" "$r"
}

# The local image id of a tag in this daemon (sha256:<64 hex>), or nothing if it is absent.
node_chrome_id() {
    id=$(denv docker image inspect -f '{{.Id}}' "$1" 2>/dev/null) || return 0
    h=${id#sha256:}
    case $id in sha256:*) ;; *) die "node-chrome: the image id is not sha256:<hex>" ;; esac
    case $h in *[!0-9a-f]*) die "node-chrome: the image id is not sha256:<hex>" ;; esac
    [ ${#h} -eq 64 ] || die "node-chrome: the image id is not sha256:<64 hex>"
    printf '%s' "$id"
}

# BROWSER_NODE_IMAGE for every browser compose call: empty (the compose file's pinned upstream
# image) unless BROWSER_NODE_CHROME=1, then the built image's id. Set in the environment, it
# wins over the env files. NODE_IMAGE_SET: resolved once per run (up resolves it after its build).
NODE_IMAGE='' NODE_IMAGE_SET=0
node_image() {
    [ "$NODE_IMAGE_SET" = 1 ] && return 0
    # Assignments, not $(..) inside a test, so that a die in them stops this run.
    c=$(node_chrome)
    if [ "$c" = 1 ]; then
        tag=$(node_chrome_tag)
        NODE_IMAGE=$(node_chrome_id "$tag")
        [ -n "$NODE_IMAGE" ] || echo "happy-svc-ctl: BROWSER_NODE_CHROME=1 but $tag is not built yet (up builds it)" >&2
    fi
    NODE_IMAGE_SET=1
}

build_node_chrome() {
    c=$(node_chrome)
    [ "$c" = 1 ] || return 0
    tag=$(node_chrome_tag)
    denv docker build -t "$tag" "$NODE_CHROME_DIR"
    NODE_IMAGE=$(node_chrome_id "$tag")
    [ -n "$NODE_IMAGE" ] || die "node-chrome: $tag is missing after its build"
    NODE_IMAGE_SET=1
    printf 'node-chrome: %s %s\n' "$tag" "$NODE_IMAGE"
}

# The last value of a key in root's browser.env (deploy-root.sh accepted the file), or nothing.
browser_setting() {
    if [ -f "$ETC/browser.env" ]; then sed -n "s/^$1=//p" "$ETC/browser.env" | tail -n 1; fi
}

# What browser.mk computes and exports for compose, worked out the same way: the geometry by the
# release's own scripts/browser-geometry.sh (the one browser.mk runs, so the formula has one home)
# from BROWSER_KIOSK, BROWSER_HEIGHT and BROWSER_WIDTH in browser.env, and EVIDENCE_TZ from
# browser.env, else the host's /etc/timezone (as browser.mk defaults it), else compose's default.
# Every value is checked again here before it reaches compose. Set in the environment, these win
# over the env files, as browser.mk's exports do (so a BROWSER_VIEWPORT_HEIGHT in browser.env is
# ignored, as browser.mk ignores .env.browser's). GEOM_SET: worked out once per run.
GEOM_ENV='' GEOM_SET=0
browser_geometry() {
    [ "$GEOM_SET" = 1 ] && return 0
    k=$(browser_setting BROWSER_KIOSK) h=$(browser_setting BROWSER_HEIGHT) w=$(browser_setting BROWSER_WIDTH)
    g=$(denv BROWSER_KIOSK="$k" BROWSER_HEIGHT="$h" BROWSER_WIDTH="$w" \
        sh "$REL/browser-stack/browser/scripts/browser-geometry.sh" "$REL/browser-stack/browser/kiosk/fluxbox/init.window") \
        || die "browser geometry: refused (BROWSER_KIOSK, BROWSER_HEIGHT or BROWSER_WIDTH in $ETC/browser.env)"
    GEOM_ENV='' seen=''
    for kv in $g; do
        key=${kv%%=*} val=${kv#*=}
        case $key in
            BROWSER_KIOSK) case $val in 0|1) ;; *) die "browser geometry: bad $key" ;; esac ;;
            BROWSER_WIDTH|BROWSER_HEIGHT|BROWSER_PANEL_HEIGHT|BROWSER_VIEWPORT_HEIGHT|CHROME_UI_HEIGHT)
                case $val in ''|*[!0-9]*|0?*) die "browser geometry: bad $key" ;; esac
                [ ${#val} -le 5 ] || die "browser geometry: bad $key" ;;
            *) die "browser geometry: unexpected output" ;;
        esac
        GEOM_ENV="$GEOM_ENV $key=$val" seen="$seen $key"
    done
    for key in BROWSER_KIOSK BROWSER_WIDTH BROWSER_HEIGHT BROWSER_PANEL_HEIGHT BROWSER_VIEWPORT_HEIGHT; do
        case "$seen " in *" $key "*) ;; *) die "browser geometry: no $key" ;; esac
    done
    tz=$(browser_setting EVIDENCE_TZ)
    if [ -n "$tz" ]; then
        valid_tz "$tz" || die "EVIDENCE_TZ in $ETC/browser.env is not a zone in /usr/share/zoneinfo"
    else
        tz=$(head -n 1 /etc/timezone 2>/dev/null | tr -d '[:space:]') || tz=''
        valid_tz "$tz" || tz=''
    fi
    if [ -n "$tz" ]; then GEOM_ENV="$GEOM_ENV EVIDENCE_TZ=$tz"; fi
    GEOM_SET=1
}

# A zone name: letters, digits, _ + - in up to three /-separated parts (no dots, so no ..), a
# file under /usr/share/zoneinfo, not one of its posix/ or right/ copies.
valid_tz() {
    z=$1
    case $z in ''|[!A-Za-z]*|*[!A-Za-z0-9_+/-]*|*//*|*/|*/*/*/*|posix/*|right/*|posixrules) return 1 ;; esac
    [ ${#z} -le 64 ] && [ -f "/usr/share/zoneinfo/$z" ]
}

# shellcheck disable=SC2086  # *_FILES are fixed strings of -f <path> pairs, paths without spaces
compose() {
    p=$1; shift
    case $p in
        vault)
            if [ -f "$ETC/vault.env" ]; then set -- --env-file "$ETC/vault.env" "$@"; fi
            denv docker compose -p happy-vault --project-directory "$REL/selfhost/vault" $VAULT_FILES "$@" ;;
        browser)
            if [ -f "$ETC/browser.env" ]; then set -- --env-file "$ETC/browser.env" "$@"; fi
            if [ -f "$BROWSER_HOME/secrets/browser.env" ]; then set -- --env-file "$BROWSER_HOME/secrets/browser.env" "$@"; fi
            node_image
            browser_geometry
            # shellcheck disable=SC2086  # GEOM_ENV: KEY=value words, each checked above
            denv BROWSER_NODE_IMAGE="$NODE_IMAGE" $GEOM_ENV docker compose -p happy-browser --project-directory "$REL/browser-stack/browser" $BROWSER_FILES "$@" ;;
        *) die "unknown project" ;;
    esac
}

project_arg() {
    case ${1:-} in
        vault|browser) printf '%s' "$1" ;;
        *) die "project: vault or browser" ;;
    esac
}

# A service name the project's own compose files declare.
service_arg() {
    p=$1 s=${2:-}
    case $s in ''|*[!a-z0-9-]*) die "service: lower-case letters, digits and -" ;; esac
    [ ${#s} -le 40 ] || die "service: too long"
    for x in $(compose "$p" config --services); do [ "$x" = "$s" ] && return 0; done
    die "service: not in the $p project"
}

# A data volume ../volumes.list names (one per line; # comments).
volume_arg() {
    v=${1:-}
    case $v in ''|*[!a-z0-9-]*) die "volume: lower-case letters, digits and -" ;; esac
    [ ${#v} -le 63 ] || die "volume: too long"
    while IFS= read -r line; do
        case $line in '#'*|'') continue ;; esac
        [ "$line" = "$v" ] && return 0
    done <"$REL/selfhost/svc/volumes.list"
    die "volume: not in volumes.list"
}

nargs() { [ "$1" -le "$2" ] && [ "$2" -le "$3" ] || die "$VERB: wrong number of arguments"; }

# --- rootlesskit's port API (builtin driver: it listens on the host and dials the same port on
# 127.0.0.1 inside the daemon's network namespace, where the host-network services bind).
rk() { denv curl -fsS --max-time 10 --unix-socket "$RK_API" "$@"; }

ports_wanted() {
    while IFS= read -r line; do
        case $line in '#'*|'') continue ;; esac
        # shellcheck disable=SC2086  # split the line into its words on purpose
        set -- $line   # "<port>" or "<lo>-<hi>", then an optional comment word
        r=$1
        case $r in
            *[!0-9-]*|-*|*-|*-*-*) die "ports.list: bad entry" ;;
            *-*) lo=${r%-*} hi=${r#*-} ;;
            *) lo=$r hi=$r ;;
        esac
        [ "$lo" -ge 1024 ] && [ "$hi" -le 65535 ] && [ "$lo" -le "$hi" ] && [ $((hi - lo)) -lt 64 ] \
            || die "ports.list: $r out of bounds"
        i=$lo; while [ "$i" -le "$hi" ]; do printf '%s\n' "$i"; i=$((i + 1)); done
    done <"$REL/selfhost/svc/ports.list"
}

# The published ports as a JSON array: rootlesskit answers null (not []) while none is
# published, and nothing at all is treated the same way; anything else that is not a list is refused.
rk_ports() {
    out=$(rk http://rootlesskit/v1/ports) || return 1
    [ -n "$out" ] || out=null
    printf '%s' "$out" | denv jq -c 'if . == null then [] elif type == "array" then map(select(type == "object")) else error("not a list") end'
}

# Remove any published port whose host side is not 127.0.0.1 (a compose `ports: "8222:8222"`
# would otherwise reach the LAN), then add the wanted ones that are missing.
do_ports() {
    [ -S "$RK_API" ] || die "rootlesskit API socket missing: is docker.service of $SVC_USER running?"
    have=$(rk_ports) || die "ports: rootlesskit's port list could not be read"
    printf '%s' "$have" | denv jq -r '.[] | select(.spec.parentIP != "127.0.0.1") | .id // empty' | while IFS= read -r id; do
        case $id in ''|*[!0-9]*) continue ;; esac
        rk -X DELETE "http://rootlesskit/v1/ports/$id" >/dev/null
        printf 'removed a non-loopback port (id %s)\n' "$id" >&2
    done
    added=0 failed=''
    for port in $(ports_wanted); do
        if printf '%s' "$have" | denv jq -e --argjson p "$port" \
            'any(.[]; .spec.parentIP == "127.0.0.1" and .spec.parentPort == $p and .spec.proto == "tcp")' >/dev/null; then
            continue
        fi
        # A port another process holds on the host is refused (400); the rest are still published.
        if rk -X POST -H 'Content-Type: application/json' \
            -d "{\"proto\":\"tcp\",\"parentIP\":\"127.0.0.1\",\"parentPort\":$port,\"childIP\":\"127.0.0.1\",\"childPort\":$port}" \
            http://rootlesskit/v1/ports >/dev/null 2>&1; then
            added=$((added + 1))
        else
            failed="$failed $port"
        fi
    done
    printf 'ports: %s added; all on 127.0.0.1\n' "$added"
    if [ -n "$failed" ]; then
        printf 'ports: not published (in use on the host? ss -ltnp):%s\n' "$failed" >&2
        return 1
    fi
}

ports_check() {
    [ -S "$RK_API" ] || { echo "ports: rootlesskit API socket missing"; return 1; }
    have=$(rk_ports) || { echo "ports: rootlesskit's port list could not be read"; return 1; }
    bad=$(printf '%s' "$have" | denv jq -r '[.[] | select(.spec.parentIP != "127.0.0.1")] | length')
    n=$(printf '%s' "$have" | denv jq -r 'length')
    printf 'ports: %s published, %s beyond 127.0.0.1\n' "$n" "$bad"
    [ "$bad" = 0 ]
}

# A one-shot helper container: no network, read-only root, only the capabilities a tar or
# copy across container uids needs (container root is $SVC_USER on the host).
helper() {
    denv docker run --rm -i --network none --read-only --tmpfs /tmp \
        --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER \
        --security-opt no-new-privileges:true --user 0:0 "$@"
}

log_verb() { logger -t happy-svc-ctl -p auth.info "verb=$1 caller=$CALLER" 2>/dev/null || true; }

# --- one at a time
mkdir -p "$RUNDIR" 2>/dev/null || true
exec 9>"$RUNDIR/happy-svc-ctl.lock"
flock -w 600 9 || die "another happy-svc-ctl is running"

VERB=${1:-}
[ $# -gt 0 ] && shift
case $VERB in
    up|down|restart|status|logs|ports|init|admin|tokens-export|controller-token|backup|admin-tty|import) ;;
    *) log_verb refused; die "unknown verb; one of: up down restart status logs ports init admin tokens-export controller-token backup admin-tty import" ;;
esac
log_verb "$VERB"

case $VERB in
up)
    nargs 0 $# 1
    if [ $# -eq 1 ]; then ps=$(project_arg "$1"); else ps="vault browser"; fi
    for p in $ps; do
        if [ "$p" = browser ]; then build_node_chrome; fi
        compose "$p" up -d --build --wait
    done
    do_ports ;;
down)
    nargs 0 $# 1
    if [ $# -eq 1 ]; then ps=$(project_arg "$1"); else ps="browser vault"; fi
    for p in $ps; do compose "$p" down; done ;;
restart)
    nargs 1 $# 2
    p=$(project_arg "$1")
    if [ $# -eq 2 ]; then service_arg "$p" "$2"; compose "$p" restart "$2"; else compose "$p" restart; fi ;;
status)
    nargs 0 $# 0
    denv docker info -f 'daemon: {{.ServerVersion}} {{.SecurityOptions}} cgroup v{{.CgroupVersion}}' || true
    for p in vault browser; do
        echo "== happy-$p"
        compose "$p" ps -a --format 'table {{.Service}}\t{{.Status}}' || true
    done
    ports_check ;;
logs)
    nargs 2 $# 3
    p=$(project_arg "$1"); service_arg "$p" "$2"
    if [ $# -eq 3 ]; then
        [ "$3" = follow ] || die "logs: the third argument may only be: follow"
        compose "$p" logs --no-color --tail 200 -f "$2"
    else
        compose "$p" logs --no-color --tail 200 "$2"
    fi ;;
ports)
    nargs 0 $# 0
    do_ports ;;
init)
    nargs 0 $# 0
    install -d -m 0700 "$DATA" "$BROWSER_HOME"
    # The vault's volumes and the filler's tree (vault-init.sh: idempotent, no secrets printed).
    owner=""
    if [ -f "$ETC/vault.env" ]; then owner=$(sed -n 's/^VAULT_OWNER_EMAIL=//p' "$ETC/vault.env" | tail -n 1); fi
    case $owner in *[!A-Za-z0-9@._+-]*) die "init: VAULT_OWNER_EMAIL in $ETC/vault.env is malformed" ;; esac
    denv VAULT_OWNER_EMAIL="$owner" bash "$REL/selfhost/vault/scripts/vault-init.sh"
    denv bash "$REL/browser-stack/browser/scripts/browser-init.sh"
    compose vault build filler
    compose vault --profile admin run --rm --no-deps -T filler-admin init ;;
admin)
    nargs 1 $# 3
    sub=$1; shift
    case $sub in
        init|items|tokens-missing|controller-token-take|outbox-clear|check-policy|policy-upgrade) nargs 0 $# 0 ;;
        seed-policy)
            nargs 0 $# 1
            if [ $# -eq 1 ]; then
                c=${1#CLIENT=}
                case $1 in CLIENT=*) ;; *) die "seed-policy: CLIENT=<name> only" ;; esac
                case $c in ''|*[!a-z0-9_-]*) die "seed-policy: CLIENT is lower-case letters, digits, _ and -" ;; esac
                [ ${#c} -le 32 ] || die "seed-policy: CLIENT too long"
            fi ;;
        token-issue)
            nargs 1 $# 2
            case $1 in NAME=bridge-client|NAME=vault-client) ;; *) die "token-issue: NAME=bridge-client or NAME=vault-client" ;; esac
            if [ $# -eq 2 ]; then [ "$2" = ROTATE=1 ] || die "token-issue: the second argument may only be ROTATE=1"; fi ;;
        *) die "admin: one of init items tokens-missing token-issue controller-token-take outbox-clear check-policy policy-upgrade seed-policy" ;;
    esac
    compose vault --profile admin run --rm --no-deps -T filler-admin "$sub" "$@" ;;
admin-tty)
    nargs 1 $# 1
    case $1 in enroll|policy-edit) ;; *) die "admin-tty: enroll or policy-edit" ;; esac
    [ -t 0 ] && [ -t 1 ] || die "admin-tty needs your terminal"
    compose vault --profile admin run --rm --no-deps filler-admin "$1"
    if [ "$1" = enroll ]; then compose vault restart filler; fi ;;
tokens-export)
    nargs 0 $# 0
    # Read-only mounts; each value checked against the token shape before it is printed.
    out=$(helper -v "$FILLER_VOLUME:/f:ro" -v "$BROWSER_HOME/secrets:/b:ro" "$HELPER_IMAGE" \
        sh -c 'for f in /f/outbox/bridge-client-token /f/outbox/vault-client-token /b/api-token; do
                 [ -f "$f" ] && [ ! -L "$f" ] || continue
                 printf "%s " "${f##*/}"; head -c 600 "$f" | head -n 1; echo
               done')
    printf '%s\n' "$out" | while IFS=' ' read -r name val rest; do
        [ -n "$name" ] || continue
        case $name in bridge-client-token|vault-client-token|api-token) ;; *) die "tokens-export: unexpected name" ;; esac
        [ -z "$rest" ] || die "tokens-export: malformed $name"
        case $val in ''|*[!A-Za-z0-9._~+/=-]*) die "tokens-export: $name is not a token" ;; esac
        [ ${#val} -ge 16 ] && [ ${#val} -le 512 ] || die "tokens-export: $name has a bad length"
        printf '%s %s\n' "$name" "$val"
    done ;;
controller-token)
    nargs 0 $# 0
    # Written by container root (not uid 1990, the filler), as the filler's handoff check
    # requires; inbox/ is setgid 1990, so the file is group 1990 and 0640 like make's own.
    helper -v "$BROWSER_HOME/secrets:/b:ro" -v "$FILLER_VOLUME:/f" "$HELPER_IMAGE" \
        sh -c 'umask 027; t=/f/inbox/.controller-token.$$; cp /b/api-token "$t" && chmod 0640 "$t" && mv -f "$t" /f/inbox/controller-token'
    compose vault --profile admin run --rm --no-deps -T filler-admin controller-token-take ;;
backup)
    nargs 0 $# 0
    ts=$(date -u +%Y%m%dT%H%M%SZ)
    dst=$BACKUPS/$ts
    install -d -m 0700 "$BACKUPS" "$dst"
    while IFS= read -r v; do
        case $v in '#'*|'') continue ;; esac
        if [ "$v" = browser-home ]; then src=$BROWSER_HOME; else
            denv docker volume inspect "$v" >/dev/null 2>&1 || { echo "backup: $v absent, skipped"; continue; }
            src=$v
        fi
        helper -v "$src:/src:ro" "$HELPER_IMAGE" tar -C /src -czf - . >"$dst/$v.tar.gz"
        echo "backup: $v $(stat -c %s "$dst/$v.tar.gz") bytes"
    done <"$REL/selfhost/svc/volumes.list"
    (cd "$dst" && sha256sum -- *.tar.gz >SHA256SUMS)
    # Mirrors: absolute directories, one per line, in root's $ETC/backup-mirrors; each must be
    # $SVC_USER's and 0700. Copies only; nothing is ever pruned here.
    if [ -f "$ETC/backup-mirrors" ]; then
        while IFS= read -r m; do
            case $m in '#'*|'') continue ;; /*) ;; *) echo "backup: mirror $m is not absolute, skipped"; continue ;; esac
            case $m in *[!A-Za-z0-9/_.-]*|*..*) echo "backup: mirror name refused, skipped"; continue ;; esac
            [ "$(stat -c '%U %a' "$m" 2>/dev/null)" = "$SVC_USER 700" ] || { echo "backup: $m is not $SVC_USER's 0700, skipped"; continue; }
            cp -a "$dst" "$m/" && echo "backup: copied to $m/$ts"
        done <"$ETC/backup-mirrors"
    fi
    echo "backup: $dst" ;;
import)
    nargs 1 $# 1
    volume_arg "$1"; v=$1
    src=$DROP/in/$v.tar
    [ -f "$src" ] && [ ! -L "$src" ] || die "import: no regular file $src"
    if [ "$v" = browser-home ]; then
        tgt=$BROWSER_HOME
        install -d -m 0700 "$DATA" "$tgt"
        [ -z "$(ls -A "$tgt")" ] || die "import: $tgt is not empty; move it aside first"
    else
        if denv docker volume inspect "$v" >/dev/null 2>&1; then die "import: volume $v exists; refusing to overwrite"; fi
        denv docker volume create --label happy-svc.imported=1 "$v" >/dev/null
        tgt=$v
    fi
    helper -v "$tgt:/dst" "$HELPER_IMAGE" tar -C /dst -xpf - --numeric-owner <"$src"
    # The operator's part of the browser home (secrets/, uid and gid 1000 under the operator's
    # Docker) becomes happy-svc's, container uid 0; the services' own uids (199x) are kept, and
    # browser-init.sh then sets every service directory's owner as the compose file expects.
    if [ "$v" = browser-home ]; then
        helper -v "$tgt:/dst" "$HELPER_IMAGE" sh -c 'find /dst -user 1000 -exec chown -h 0 {} + && find /dst -group 1000 -exec chgrp -h 0 {} +'
        denv bash "$REL/browser-stack/browser/scripts/browser-init.sh"
    fi
    # The tarball holds secrets: out of the drop, into $SVC_USER's own space (never deleted).
    ts=$(date -u +%Y%m%dT%H%M%SZ)
    install -d -m 0700 "$HOME_DIR/imported" "$HOME_DIR/imported/$ts"
    mv "$src" "$HOME_DIR/imported/$ts/"
    echo "import: $v done; the tarball is in $HOME_DIR/imported/$ts" ;;
esac
