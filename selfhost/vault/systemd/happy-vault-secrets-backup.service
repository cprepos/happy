# Nightly root-side backup of the filler's state and the vault env file
# (selfhost/vault/scripts/vault-secrets-backup.sh, installed as
# /usr/local/sbin/happy-vault-secrets-backup). System unit; see make vault-backup-setup.
[Unit]
Description=Vault secrets backup (filler state, vaultwarden.env) to the backup mirrors
After=local-fs.target zfs-mount.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/local/sbin/happy-vault-secrets-backup
