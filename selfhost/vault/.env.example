# Host-specific settings of the vault stack. Copy to .env (gitignored) and fill
# in. Read by docker compose (compose.vault.yml, from this directory) and by
# make (selfhost/vault.mk includes it), so keep it to plain KEY=value lines:
# no quotes, no spaces around =, no ${...}.

# The public name of the vault (Caddy site, Vaultwarden's DOMAIN).
VAULT_DOMAIN=vault.example.org
# The Caddy site make vault-caddy-apply puts the vault's site after, and the
# Caddyfile it edits (Caddy runs on the host, not in this compose).
CADDY_AFTER_SITE=happy.example.org
CADDYFILE=/home/me/caddy/Caddyfile
# The agent's own vault account, the default make vault-enroll offers.
VAULT_AGENT_EMAIL=agent@vault.example.org

# The old root-made /srv trees, from before the data moved into named volumes.
# Read (never changed) by make vault-migrate-volumes and vault-filler-cutover;
# they stay as the rollback.
VAULT_ROOT=/srv/happy-vault
FILLER_ROOT=/srv/happy-filler
# Service uids (no login accounts needed): Vaultwarden's and the filler's.
VAULT_UID=1991
FILLER_UID=1990
FILLER_GID=1990

# The LAN: this server's address (the agent gateway's and the bridge's LAN
# listener) and the Macs allowed to use them, as name=ip pairs.
LAN_IP=192.0.2.10
LAN_CLIENTS=mac-a=192.0.2.11,mac-b=192.0.2.12
