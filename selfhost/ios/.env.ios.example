# Copy to selfhost/ios/.env.ios (gitignored) and fill in.
# Read by selfhost/ios/build.sh. Plain KEY=value lines; quote values with spaces.

# 10-character Apple team ID (becomes DEVELOPMENT_TEAM).
# Xcode > Settings > Accounts > your Apple ID > team row, or
# developer.apple.com > Membership. A free "Personal Team" also has one:
# Keychain Access > your "Apple Development: ..." certificate > Organizational Unit.
APPLE_TEAM_ID=ABCDE12345

# Reverse-DNS prefix you control. Bundle IDs are globally unique across Apple,
# so do not reuse com.slopus.* or com.ex3ndr.*. The app config appends a suffix.
APP_BUNDLE_ID_PREFIX=org.duckdns.girthbass

# Name shown under the home-screen icon.
APP_DISPLAY_NAME="Happy Self"

# Public URL of the self-hosted server (no trailing slash).
HAPPY_PUBLIC_URL=https://happy.girthbass.duckdns.org

# development | preview | production (default: preview).
APP_ENV=preview

# Optional: device name or UDID (see `xcrun xctrace list devices`).
# Empty = pick interactively. With --simulator: a simulator name, e.g. "iPhone 16 Pro".
DEVICE=
