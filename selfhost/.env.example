# Self-hosted Happy configuration.
# Copy to selfhost/.env (gitignored) and fill in, or run `make env` to
# generate one with random secrets.

# Master key for auth tokens and server-side encryption.
# Generate with: openssl rand -hex 32
# Changing it invalidates all existing tokens and server-encrypted data.
HANDY_MASTER_SECRET=

# Postgres credentials. The database is reachable only inside the compose network.
POSTGRES_USER=happy
POSTGRES_PASSWORD=
POSTGRES_DB=happy

# Public base URL of the server (Caddy terminates TLS and proxies to 127.0.0.1:3005).
# Used to build download links for locally stored files.
PUBLIC_URL=https://happy.girthbass.duckdns.org

# Prometheus metrics server on port 9090 inside the container (never published). true/false.
METRICS_ENABLED=false

# Host directory holding the built webapp (index.html at its root). Relative to selfhost/.
# HAPPY_WEBAPP_DIR=./webapp
