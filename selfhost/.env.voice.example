# Copy to .env.voice (gitignored) and fill in. `make voice-keys` generates the LiveKit pair.

# LiveKit API key pair (used by livekit-server, happy-server token minting, and the voice agent)
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret
# LiveKit has no public URL: apps stream audio through happy-server, which reaches LiveKit
# on the happy-selfhost docker network (ws://livekit:7880). The agent uses ws://127.0.0.1:7880.

# Host directory holding the Hugging Face hub cache (models--org--name folders)
HF_CACHE_DIR=/mnt/ai-data/huggingface
# Optional token for gated/rate-limited downloads
HF_TOKEN=

# GPU mapping (host GPU indices). Keep STT and TTS on separate GPUs: the STT server takes a
# global GPU lock for every 10-20 ms streaming step, so Kokoro synthesis sharing the device
# queues behind it and reply audio turns choppy.
STT_GPU=0
TTS_GPU=1
# Optional local voice LLM (compose profile "local-llm", off by default) runs TP=2 on these
# two host GPUs. GPUs 2+3 are taken by the separate "coder" vLLM systemd service.
LLM_GPU_A=0
LLM_GPU_B=1

# Host ports (all bound to 127.0.0.1)
STT_PORT=8090
TTS_PORT=8880
LLM_PORT=8000

# STT model + streaming latency (att_context_size right context: 0=80ms,1=160ms,6=560ms,13=1120ms chunks)
STT_MODEL=nvidia/nemotron-speech-streaming-en-0.6b
STT_RIGHT_CONTEXT=6

# Server-wide default Kokoro voice for English replies, used when a chat has no voice picked
# in the app (Settings > Voice, or a chat's info screen). A single voice (af_heart, bm_george)
# or a weighted blend such as am_michael(2)+am_onyx(1). List voices with:
#   curl -s http://127.0.0.1:${TTS_PORT}/v1/audio/voices
# Other languages keep their own per-language voice (happy_voice/config.py).
TTS_VOICE=af_heart
# Speech rate multiplier: 1.0 is Kokoro's default pace (~170 wpm); the app may request 0.5-1.5.
TTS_SPEED=1.0

# LLM the voice agent talks to (OpenAI-compatible). Default: the host's coder vLLM
# (systemd, port 9080, Qwen3.8-27B FP8, thinking disabled per request). The worker runs on the
# host network, so 127.0.0.1 reaches it.
VOICE_LLM_BASE_URL=http://127.0.0.1:9080/v1
VOICE_LLM_MODEL=coder
# Seconds the agent waits for the LLM's next streamed bytes; the first wait covers queueing and
# prefill, which on the shared coder vLLM can take well over the library's 10 s default.
# LLM_TIMEOUT=60
# Retries of a failed LLM request (each one restarts the prefill).
# LLM_MAX_RETRY=0
# Barge-in gate: seconds of speech and STT words before the agent stops talking, and the
# silence after which a wordless interruption resumes its speech (off disables).
# INTERRUPT_MIN_DURATION=0.8
# INTERRUPT_MIN_WORDS=1
# FALSE_INTERRUPTION_TIMEOUT=2.0
# Longest wait after the user stops talking when the turn detector expects more.
# MAX_ENDPOINTING_DELAY=1.5

# Optional local voice LLM (profile local-llm: make voice-up SVC=llm or --profile local-llm).
# To use it, set VOICE_LLM_BASE_URL=http://127.0.0.1:${LLM_PORT}/v1 and VOICE_LLM_MODEL=voice-llm.
LLM_MODEL=QuantTrio/Qwen3.6-35B-A3B-AWQ
LLM_SERVED_NAME=voice-llm
LLM_MAX_MODEL_LEN=32768
# Fraction of EACH GPU vLLM may use. GPU 0 already holds ~1.6 GB for STT and GPU 1 ~1.5 GB for
# TTS, so keep <= 0.90; 0.68 is the measured-safe setting.
LLM_GPU_MEM_UTIL=0.68
