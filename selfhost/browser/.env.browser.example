# Live browser stack settings. Copy to selfhost/browser/.env.browser (gitignored)
# only to change a default; every line is optional.
#
# Secrets are NOT set here. `make browser-init` generates them into
# ~/.local/share/happy-browser/secrets/ (mode 600) and the Makefile passes
# secrets/browser.env to compose. Its keys, for reference:
#   API_BEARER_TOKEN=            auto-browser controller token (also secrets/api-token)
#   VNC_PASSWORD=                noVNC password, 8 characters (also secrets/vnc-password)
#   AUTH_STATE_ENCRYPTION_KEY=   Fernet key for saved logins (secrets/auth-state-key)
#   SHARE_TOKEN_SECRET=          signs observer tokens (secrets/share-token-secret)

# Xvfb screen and Chromium window, in pixels. Phone-shaped by default.
# BROWSER_WIDTH=480
# BROWSER_HEIGHT=1040
# Page viewport height: the screen height less ~90px of browser toolbar.
# BROWSER_VIEWPORT_HEIGHT=950

# Loopback ports (always bound to 127.0.0.1).
# NOVNC_PORT=6080
# API_PORT=8010
# BRIDGE_PORT=6090

# MAX_SESSIONS=3
# MCP_TOOL_PROFILE=curated
# REQUEST_RATE_LIMIT_REQUESTS=1200
# Redact PII found by OCR in screenshots and live frames (costs OCR per frame).
# PII_SCRUB_SCREENSHOT=true
# LOG_LEVEL=INFO
